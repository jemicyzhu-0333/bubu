{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bubu:expression-policy:p0",
  "title": "Bubu fixed expression policy P0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "sourceSha256",
    "profileSha256",
    "candidates"
  ],
  "properties": {
    "format": {
      "const": "bubu-expression-policy-p0"
    },
    "version": {
      "const": "0.1.0-p0"
    },
    "sourceSha256": {
      "const": "a9ae09635658ac15c55cf1571db53e284bd463eaab9a84ff24e7836270a1808e"
    },
    "profileSha256": {
      "const": "14b268270370477caac18cdbefa6a95a4a1d078c674527315f67f1b24e045997"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "faceId",
          "amount",
          "enterSec",
          "exitSec",
          "holdSec",
          "gapSec"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "faceId": {
            "enum": [
              "04",
              "N3",
              "A7",
              "07",
              "S5",
              "R0",
              "N2"
            ]
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "enterSec": {
            "type": "number",
            "minimum": 0.04,
            "maximum": 2
          },
          "exitSec": {
            "type": "number",
            "minimum": 0.04,
            "maximum": 2
          },
          "holdSec": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 3600
          },
          "gapSec": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 3600
          }
        }
      }
    }
  }
}
