        "choosing orientation solely by nearest IK"
      ]
    },
    "fixed-support-surface": {
      "evaluate": [
        "actual opaque boundary versus immutable floor",
        "zero penetration",
        "normal alignment",
        "planted drift during loaded interval",
        "load/recovery phase",
        "continuous source wrist connection"
