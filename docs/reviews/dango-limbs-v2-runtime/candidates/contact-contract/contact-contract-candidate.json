      ]
    },
    "phase-gated-touch": {
      "evaluate": [
        "key surface gap/penetration during contact phase only",
        "lift separation and recovery timing",
        "alternating left/right phase",
        "source-defined underside normal",
        "no body/prop shift"
      ],
      "contactPhaseStatus": "blocked-until-palm-center-to-surface conversion verified",
      "neverAcceptBy": [
